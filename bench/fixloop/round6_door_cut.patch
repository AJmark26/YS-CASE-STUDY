+def _split_at_doors(polys, ops, G, carved, max_ext=2.5, max_crossed=0.25, min_area=1.5, min_width=0.6):
+    """Cut rooms that run on through a door. Returns the new polygons, or None if none was cut.
+
+    rooms.close_doors closes a doorway only where wall was seen on both sides of it. On a short
+    walk the wall beside a door is often not scanned, so the room runs on through the door into
+    the space beyond. A door that openings.detect_lines finds inside a room, rather than on its
+    outline, shows this. The room is cut along the door's wall line, from the door to the
+    outline, if rays crossed that extension of the line along less than a quarter of it (wall
+    that was not scanned, not open floor), it is at most `max_ext` long on each side, and both
+    parts are at least `min_area` and `min_width` wide. The caller then drops a part the camera
+    never entered, as for any room seen only through a doorway.
+    """
+    from shapely.geometry import LineString, Point
+    from shapely.ops import split
+    out, cut = list(polys.values()), False
+    for o in ops:
+        if o["type"] != "door":
+            continue
+        u = o["axis"] == "u"
+        a0, a1, line = o["from"], o["to"], o["line"]
+        mid = Point(((a0 + a1) / 2, line) if u else (line, (a0 + a1) / 2))
+        for i, p in enumerate(out):
+            if not p.contains(mid) or p.exterior.distance(mid) < 0.15:
+                continue
+            x0, y0, x1, y1 = p.bounds
+            inter = p.intersection(LineString([(x0 - 1, line), (x1 + 1, line)] if u else [(line, y0 - 1), (line, y1 + 1)]))
+            segs = [g for g in getattr(inter, "geoms", [inter]) if g.geom_type == "LineString"]
+            seg = min(segs, key=lambda g: g.distance(mid), default=None)
+            if seg is None or seg.distance(mid) > 1e-6:
+                continue
+            ts = [c[0] if u else c[1] for c in seg.coords]
+            lo, hi = min(ts), max(ts)
+            if max(a0 - lo, hi - a1) > max_ext:
+                continue
+            t = np.concatenate([np.arange(lo, a0, 0.02), np.arange(a1, hi, 0.02)])
+            if len(t) and openings._crossed(G, carved, 2 if u else 0, line, t, (-0.04, 0.0, 0.04)).mean() >= max_crossed:
+                continue
+            parts = list(split(p, seg).geoms)
+            if len(parts) != 2 or any(q.area < min_area or q.buffer(-min_width / 2).is_empty for q in parts):
+                continue
+            out[i:i + 1] = parts
+            cut = True
+            break
+    return {i: p for i, p in enumerate(out, 1)} if cut else None
+
